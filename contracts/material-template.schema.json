{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material template (declarative-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "format",
    "answerSheet",
    "taskSheet"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "declarative-v1"
    },
    "answerSheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Block"
      }
    },
    "taskSheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Block"
      }
    }
  },
  "$defs": {
    "Block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "field"
            },
            "field": {
              "enum": [
                "heading",
                "taskNumber",
                "statement",
                "blankNumber",
                "teamName",
                "gameTitle",
                "modifierLabel"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "qr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "answer-area"
            }
          }
        }
      ]
    }
  }
}

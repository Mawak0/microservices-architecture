{
  "openapi": "3.1.0",
  "info": { "title": "Sapientum Intake Service", "version": "0.1.0", "description": "Контракт приёма. Реализация отсутствует. Ошибки и правила — SERVICE.md и CONTRACTS.md." },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/intake-sessions/{gameId}": {
      "parameters": [{ "in": "path", "name": "gameId", "required": true, "schema": { "type": "string" } }],
      "put": {
        "operationId": "openIntakeSession", "x-roles": ["admin", "integration"],
        "description": "Синхронизировать открытый сеанс с актуальным состоянием игры. Не открывает закрытый цикл заново.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CycleRequest" } } } },
        "responses": { "200": { "description": "Сеанс готов", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "get": { "operationId": "getIntakeSession", "x-roles": ["admin", "observer", "integration"], "responses": {
        "200": { "description": "Состояние сеанса", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
        "default": { "$ref": "#/components/responses/Error" }
      } }
    },
    "/intake-sessions/{gameId}/close": {
      "parameters": [{ "in": "path", "name": "gameId", "required": true, "schema": { "type": "string" } }],
      "post": {
        "operationId": "closeIntakeSession", "x-roles": ["admin", "integration"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CycleRequest" } } } },
        "responses": { "200": { "description": "Приём закрыт, полный manifest зафиксирован", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/receipts": {
      "post": {
        "operationId": "acceptBlank", "x-roles": ["admin", "observer"],
        "description": "Атомарный бизнес-эффект приёма одного бланка. 201 только после надёжного сохранения снимка и факта приёма.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitBlank" } } } },
        "responses": {
          "201": { "description": "Ответ принят", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } } } },
          "200": { "description": "Повтор того же запроса", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/receipts/{id}": {
      "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "getReceipt", "x-roles": ["admin", "observer", "checker", "integration"], "responses": {
        "200": { "description": "Сохранённая квитанция", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } } } },
        "default": { "$ref": "#/components/responses/Error" }
      } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": { "IdempotencyKey": { "in": "header", "name": "Idempotency-Key", "required": true, "schema": { "type": "string", "minLength": 1 } } },
    "responses": { "Error": { "description": "401/403/404/409/422/503; коды в SERVICE.md", "content": { "application/json": { "schema": { "$ref": "./common.json#/$defs/Error" } } } } },
    "schemas": {
      "CycleRequest": { "type": "object", "additionalProperties": false, "required": ["cycleId"], "properties": { "cycleId": { "type": "string", "minLength": 1 } } },
      "Session": {
        "type": "object", "required": ["gameId", "cycleId", "status", "receiptIds"],
        "properties": { "gameId": { "type": "string" }, "cycleId": { "type": "string" }, "status": { "enum": ["open", "closed"] },
          "receiptIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
      },
      "SubmitBlank": {
        "type": "object", "additionalProperties": false, "required": ["qrToken", "imageBase64", "imageMediaType", "legibilityConfirmed"],
        "properties": { "qrToken": { "type": "string", "minLength": 1 },
          "imageBase64": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
          "imageMediaType": { "enum": ["image/png", "image/jpeg"] }, "legibilityConfirmed": { "const": true } }
      },
      "Receipt": {
        "type": "object", "required": ["id", "blankId", "gameId", "cycleId", "teamId", "imageRef", "acceptedAt"],
        "properties": { "id": { "type": "string" }, "blankId": { "type": "string" }, "gameId": { "type": "string" },
          "cycleId": { "type": "string" }, "teamId": { "type": "string" }, "imageRef": { "type": "string", "minLength": 1 },
          "acceptedAt": { "type": "string", "format": "date-time" } }
      }
    }
  }
}

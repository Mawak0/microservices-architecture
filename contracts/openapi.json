{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "/",
      "description": "Адрес экземпляра задаётся при развёртывании"
    }
  ],
  "info": {
    "title": "Sapientum Review and Appeals Service",
    "version": "0.3.0",
    "description": "Предлагаемый API без реализации; бизнес-правила и ошибки — SERVICE.md."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/integrations/receipts": {
      "post": {
        "operationId": "receiveAcceptedReceipt",
        "summary": "Получить событие принятого ответа",
        "x-roles": [
          "integration",
          "admin"
        ],
        "description": "Доставка ReceiptAccepted. Дедупликация и по eventId, и по receiptId; ранее принятые ответы доставляются и после срока сдачи.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./intake-events.schema.json"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "ReceiptAccepted"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "201": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/integrations/intake-closures": {
      "post": {
        "operationId": "receiveIntakeManifest",
        "summary": "Получить полный список принятых ответов",
        "x-roles": [
          "integration",
          "admin"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "./intake-events.schema.json"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "IntakeClosed"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Completion"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Manifest охватывает все ответы игры. Старые admissionVersion подтверждаются без изменения актуальной полноты; новые версии не сбрасывают дела и квоту."
      }
    },
    "/checks": {
      "get": {
        "operationId": "listChecks",
        "summary": "Список дел игры",
        "x-roles": [
          "admin",
          "checker"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "gameId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Дела игры",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Check"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checks/next": {
      "post": {
        "operationId": "claimNextCheck",
        "summary": "Взять следующий ответ",
        "x-roles": [
          "admin",
          "checker"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "gameId"
                ],
                "properties": {
                  "gameId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "204": {
            "description": "Нет доступных дел; это не подтверждение полноты проверок"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": " Назначение временное: при now >= lease.expiresAt без продления возвращается в очередь. Каждый новый claim выдаёт новый token."
      }
    },
    "/checks/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getCheck",
        "summary": "Прочитать дело ответа",
        "x-roles": [
          "admin",
          "checker",
          "integration"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checks/{id}/claim": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "claimCheck",
        "summary": "Назначить дело проверяющему",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Атомарно назначить свободное дело текущему проверяющему. Назначение временное: при now >= lease.expiresAt без продления возвращается в очередь. Каждый новый claim выдаёт новый token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checks/{id}/release": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "releaseCheck",
        "summary": "Освободить назначение",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Вернуть назначенное дело в очередь; только исполнитель или администратор. Требуется действующее назначение и его Assignment-Token. Просроченное назначение — 409 ASSIGNMENT_EXPIRED, токен прежнего назначения — 409 STALE_ASSIGNMENT.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checks/{id}/verdict": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "recordVerdict",
        "summary": "Сохранить выбор «верно» или «неверно»",
        "x-roles": [
          "admin",
          "checker"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerdictRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": " Требуется действующее назначение и его Assignment-Token. Просроченное назначение — 409 ASSIGNMENT_EXPIRED, токен прежнего назначения — 409 STALE_ASSIGNMENT."
      }
    },
    "/checks/{id}/corrections": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "correctVerdictAsAdmin",
        "summary": "Исправить вердикт администратором",
        "x-roles": [
          "admin"
        ],
        "description": "Прямое административное исправление, не апелляция. Работает и в домино.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeal-quotas/{gameId}": {
      "parameters": [
        {
          "in": "path",
          "name": "gameId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "setAppealLimit",
        "summary": "Установить общий лимит апелляций игры",
        "x-roles": [
          "admin"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit"
                ],
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Quota"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "getAppealQuota",
        "summary": "Узнать остаток общей квоты",
        "x-roles": [
          "admin",
          "observer",
          "checker",
          "integration"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Quota"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals": {
      "post": {
        "operationId": "fileAppeal",
        "summary": "Подать апелляцию по просьбе участника",
        "x-roles": [
          "admin",
          "observer"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "checkId",
                  "reason"
                ],
                "properties": {
                  "checkId": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "201": {
            "$ref": "#/components/responses/Appeal"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals/{id}/claim": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "claimAppeal",
        "summary": "Взять апелляцию на рассмотрение",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Назначить апелляцию и вернуть исходный снимок/вердикт в поле check. Назначение временное: при now >= lease.expiresAt без продления возвращается в очередь. Каждый новый claim выдаёт новый token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals/{id}/resolve": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "resolveAppeal",
        "summary": "Вынести решение по апелляции",
        "x-roles": [
          "admin",
          "checker"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppealResolution"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": " Требуется действующее назначение и его Assignment-Token. Просроченное назначение — 409 ASSIGNMENT_EXPIRED, токен прежнего назначения — 409 STALE_ASSIGNMENT."
      }
    },
    "/games/{gameId}/completion": {
      "parameters": [
        {
          "in": "path",
          "name": "gameId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getReviewCompletion",
        "summary": "Проверить полноту с учётом текущего разрешения приёма",
        "x-roles": [
          "admin",
          "integration"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Completion"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/checks/{id}/renew": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "renewCheckAssignment",
        "summary": "Продлить текущее назначение",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Только текущий исполнитель с действующим Assignment-Token продлевает срок от серверного now. Просроченное назначение нельзя продлить. Изменения вердикта/истории/квоты нет.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Check"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals/{id}/renew": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "renewAppealAssignment",
        "summary": "Продлить текущее назначение",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Только текущий исполнитель с действующим Assignment-Token продлевает срок от серверного now. Просроченное назначение нельзя продлить. Изменения вердикта/истории/квоты нет.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals/{id}/release": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "releaseAppealAssignment",
        "summary": "Вернуть апелляцию в очередь",
        "x-roles": [
          "admin",
          "checker"
        ],
        "description": "Исполнитель или администратор с текущим Assignment-Token освобождает назначение; апелляция остаётся поданной, квота не возвращается.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/AssignmentToken"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/appeals/next": {
      "post": {
        "operationId": "claimNextAppeal",
        "summary": "Взять следующую апелляцию",
        "x-roles": [
          "admin",
          "checker"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "gameId"
                ],
                "properties": {
                  "gameId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Appeal"
          },
          "204": {
            "description": "Нет доступных дел; это не подтверждение полноты проверок"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Атомарно взять ожидающую апелляцию этой игры, включая автоматически возвращённую после истечения назначения. Новый token; пустая очередь — 204."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "AssignmentToken": {
        "in": "header",
        "name": "Assignment-Token",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "Token текущего назначения. Автоматически передаётся UI; не часть ответа участника."
      }
    },
    "responses": {
      "Error": {
        "description": "401/403/404/409/422/503; коды в SERVICE.md",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./common.json#/$defs/Error"
            }
          }
        }
      },
      "Check": {
        "description": "Дело проверки",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Check"
            }
          }
        }
      },
      "Quota": {
        "description": "Общая квота игры",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Quota"
            }
          }
        }
      },
      "Appeal": {
        "description": "Апелляция",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Appeal"
            }
          }
        }
      },
      "Completion": {
        "description": "Полнота проверок игры при актуальном режиме приёма",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Completion"
            }
          }
        }
      }
    },
    "schemas": {
      "VerdictRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "correct",
              "incorrect"
            ]
          }
        }
      },
      "CorrectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "reason"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "correct",
              "incorrect"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Check": {
        "type": "object",
        "required": [
          "id",
          "receiptId",
          "blankId",
          "gameId",
          "admissionVersion",
          "teamId",
          "imageRef",
          "status",
          "assignedTo",
          "originalVerdict",
          "verdict",
          "revision",
          "history",
          "taskId",
          "taskNumber",
          "referenceAnswer",
          "lease"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "receiptId": {
            "type": "string"
          },
          "blankId": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "admissionVersion": {
            "type": "integer",
            "minimum": 1
          },
          "teamId": {
            "type": "string"
          },
          "imageRef": {
            "type": "string"
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "checking",
              "checked",
              "appeal-pending",
              "appeal-checking"
            ]
          },
          "assignedTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "originalVerdict": {
            "enum": [
              "correct",
              "incorrect",
              null
            ]
          },
          "verdict": {
            "enum": [
              "correct",
              "incorrect",
              null
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "verdict",
                "actorId",
                "recordedAt"
              ],
              "properties": {
                "verdict": {
                  "enum": [
                    "correct",
                    "incorrect"
                  ]
                },
                "actorId": {
                  "type": "string"
                },
                "recordedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "taskNumber": {
            "type": "string",
            "minLength": 1
          },
          "referenceAnswer": {
            "type": "string",
            "description": "Неизменяемый серверный эталон по точному taskId бланка; новая задача никогда не подменяет его."
          },
          "lease": {
            "$ref": "#/components/schemas/AssignmentLease"
          }
        }
      },
      "Quota": {
        "type": "object",
        "required": [
          "gameId",
          "limit",
          "used",
          "remaining"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Appeal": {
        "type": "object",
        "required": [
          "id",
          "checkId",
          "status",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "checkId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "checking",
              "resolved"
            ]
          },
          "outcome": {
            "enum": [
              "upheld",
              "jury-error-corrected",
              null
            ]
          },
          "check": {
            "$ref": "#/components/schemas/Check"
          }
        }
      },
      "AppealResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "reason"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "upheld",
              "jury-error-corrected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "correct",
              "incorrect"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "jury-error-corrected"
                }
              }
            },
            "then": {
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {}
              }
            }
          }
        ],
        "description": "jury-error-corrected требует нового, отличного от текущего вердикта. Без изменения решения квота не возвращается."
      },
      "Completion": {
        "type": "object",
        "required": [
          "gameId",
          "admissionVersion",
          "manifestReceived",
          "complete",
          "missingReceiptIds",
          "pendingCheckIds",
          "pendingAppealIds",
          "acceptingSubmissions"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "admissionVersion": {
            "type": "integer",
            "minimum": 1
          },
          "manifestReceived": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "missingReceiptIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "pendingCheckIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "pendingAppealIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "acceptingSubmissions": {
            "type": "boolean",
            "description": "Приём разрешён обычным сроком или lateSubmissionAllowed; при true complete всегда false."
          }
        }
      },
      "AssignmentLease": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "token",
          "expiresAt"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Текущее временное назначение; null вне проверки. Новый claim выдаёт новый token; heartbeat продлевает expiresAt без смены token."
      }
    }
  }
}

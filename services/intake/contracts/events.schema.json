{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake events",
  "allOf": [
    {
      "$ref": "./common.json#/$defs/Event"
    }
  ],
  "properties": {
    "type": {
      "enum": [
        "ReceiptAccepted",
        "IntakeClosed"
      ]
    },
    "data": {
      "type": "object",
      "required": [
        "gameId",
        "admissionVersion"
      ],
      "properties": {
        "gameId": {
          "type": "string"
        },
        "admissionVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "processVersion": {
      "type": "integer",
      "const": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "ReceiptAccepted"
        },
        "data": {
          "required": [
            "receiptId",
            "blankId",
            "teamId",
            "imageRef",
            "acceptedAt",
            "taskId",
            "taskNumber"
          ],
          "properties": {
            "receiptId": {
              "type": "string"
            },
            "blankId": {
              "type": "string"
            },
            "teamId": {
              "type": "string"
            },
            "imageRef": {
              "type": "string"
            },
            "acceptedAt": {
              "type": "string",
              "format": "date-time"
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "taskNumber": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "IntakeClosed"
        },
        "data": {
          "required": [
            "receiptIds"
          ],
          "properties": {
            "receiptIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
